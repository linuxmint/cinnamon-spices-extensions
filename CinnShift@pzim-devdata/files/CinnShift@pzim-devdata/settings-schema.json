    "section-custom": {
        "type": "section",
        "description": "Custom CSS selectors (advanced)"
    },
    "custom-css": {
        "type": "entry",
        "description": "Extra CSS selectors",
        "tooltip": "Comma or semicolon separated. Terminate with , or ; to apply. Generic selectors recolor whole blocks: use with caution.",
        "default": ""
    },
    "custom-css-help": {
        "type": "label",
        "description": "Syntax: separate several selectors with , or ; \nThe shift starts when a separator is typed. \nExamples: .menu-application-button, .menu-favorites-box,"
    },
    "custom-css-help2": {
        "type": "label",
        "description": "Find a selector for an Applet: grep -rn 'application' ~/.local/share/cinnamon/applets/Cinnamenu@json/ \nOr find a selector in a Theme : grep -i 'menu' /usr/share/cinnamon/theme/cinnamon.css. \nSee the README for examples and grep tips."
    },
    "custom-css-help3": {
        "type": "label",
        "description": "There is a command-line version in Python : CinnShift CLI for scripting theme shifting at startup or via cron, with per-selector flags and variant control. See the README."
    },
