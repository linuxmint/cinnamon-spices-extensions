{
    "section-color": {
        "type": "section",
        "description": "Color"
    },
    "accent-color": {
        "type": "colorchooser",
        "description": "Fixed accent color (used in 'manual' mode)",
        "tooltip": "Leave default purple and switch mode to change it",
        "default": "#6d4aff"
    },
        "accent-hex": {
        "type": "entry",
        "description": "Manual hex color (overrides the picker)",
        "tooltip": "Six digits with #, e.g. #6d4aff. Used when Color mode is manual and this field is valid.",
        "default": ""
    },
    "color-mode": {
        "type": "combobox",
        "description": "Color mode",
        "tooltip": "manual: use the color above; random: new random color; none: keep the existing accent",
        "default": "none",
        "options": {
            "none": "none",
            "manual": "manual",
            "random": "random"
        }
    },
    "palette": {
        "type": "combobox",
        "description": "Palette constraint",
        "tooltip": "Constrains the chosen color, or transforms the existing accent when no color is applied",
        "default": "soft",
        "options": {
            "none": "none",
            "pale": "pale",
            "vibrant": "vibrant",
            "neon": "neon",
            "grayscale": "grayscale",
            "dark": "dark",
            "soft": "soft"
        }
    },
    "section-pre": {
        "type": "section",
        "description": "Recommended CSS selectors"
    },
    "s-hover": { "type": "switch", "description": "hover", "default": true },
