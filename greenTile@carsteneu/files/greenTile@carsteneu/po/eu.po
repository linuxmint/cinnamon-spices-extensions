#: lib/ui/editor.js:72
msgid "Please enter a name."
msgstr "Idatzi izen bat."

#: lib/ui/editor.js:144
#, javascript-format
msgid "from %d"
msgstr "gutxienez %d"

#: lib/ui/editor.js:431
