msgstr "Ezabatu aurrezarpena"

#: lib/ui/editor.js:485
msgid "Really delete?"
msgstr "Benetan ezabatu?"

#: lib/ui/editor.js:486
msgid "Delete"
msgstr "Ezabatu"

#: lib/ui/editor.js:490
