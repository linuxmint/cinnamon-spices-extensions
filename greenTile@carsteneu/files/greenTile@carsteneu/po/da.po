msgstr "Auto: til"

#: lib/ui/panel.js:287 lib/ui/panel.js:293
msgid "Auto: off"
msgstr "Auto: fra"

#: lib/ui/panel.js:315
msgid "Dark theme"
msgstr "Mørkt tema"

#: lib/ui/panel.js:315
