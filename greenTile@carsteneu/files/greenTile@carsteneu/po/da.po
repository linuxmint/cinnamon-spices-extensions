msgstr "%d px"

#: lib/ui/panel.js:190
msgid "Reset sizes"
msgstr "Nulstil størrelser"

#: lib/ui/panel.js:261
#, javascript-format
msgid "Presets — workspace %d · %s"
msgstr "Forudindstillinger — arbejdsområde %d · %s"

#: lib/ui/panel.js:263
msgid "Create preset"
msgstr "Opret forudindstilling"

#: lib/ui/panel.js:263
#, javascript-format
msgid "Edit %s"
msgstr "Rediger %s"

#: lib/ui/panel.js:278
msgid "Back"
msgstr "Tilbage"

#: lib/ui/panel.js:287 lib/ui/panel.js:293
