{
    "layout": {
        "type": "layout",
        "default": "",
        "pages": [
            "p-base",
            "p-opacity",
            "p-color",
            "p-shape",
            "p-preset",
            "p-maint"
        ],
        "p-base": {
            "type": "page",
            "title": "基础",
            "sections": [
                "s-variant",
                "s-bg",
                "s-apply"
            ]
        },
        "s-variant": {
            "type": "section",
            "title": "主题与终端",
            "keys": [
                "variant",
                "terminal-palette",
                "terminal-opacity"
            ]
        },
        "s-apply": {
            "type": "section",
            "title": "工作主题",
            "keys": [
                "auto-apply",
                "apply-now"
            ]
        },
        "p-opacity": {
            "type": "page",
            "title": "透明度",
            "sections": [
                "s-surface-alpha",
                "s-state-alpha"
            ]
        },
        "s-surface-alpha": {
            "type": "section",
            "title": "界面底色",
            "keys": [
                "panel-opacity",
                "menu-opacity",
                "window-opacity"
            ]
        },
        "s-state-alpha": {
            "type": "section",
            "title": "悬停与选中",
            "keys": [
                "hover-opacity",
                "selection-alpha"
            ]
        },
        "p-color": {
            "type": "page",
            "title": "颜色",
            "sections": [
                "s-accent",
                "s-text",
                "s-semantic"
            ]
        },
        "s-bg": {
            "type": "section",
            "title": "背景",
            "keys": [
                "bg-color",
                "panel-color",
                "menu-color"
            ]
        },
        "s-accent": {
            "type": "section",
            "title": "强调与边框",
            "keys": [
                "accent-color",
                "border-color"
            ]
        },
        "s-text": {
            "type": "section",
            "title": "文字",
            "keys": [
                "fg-color",
                "fg-dim-color"
            ]
        },
        "s-semantic": {
            "type": "section",
            "title": "语义色",
            "keys": [
                "danger-color",
                "warn-color",
                "success-color"
            ]
        },
        "p-shape": {
            "type": "page",
            "title": "形状与字号",
            "sections": [
                "s-radius",
                "s-metrics"
            ]
        },
        "s-radius": {
            "type": "section",
            "title": "圆角",
            "keys": [
                "window-radius",
                "control-radius"
            ]
        },
        "s-metrics": {
            "type": "section",
            "title": "字号",
            "keys": [
                "base-font-size"
            ]
        },
        "p-preset": {
            "type": "page",
            "title": "方案",
            "sections": [
                "s-preset-io",
                "s-preset-maint"
            ]
        },
        "s-preset-io": {
            "type": "section",
            "title": "保存 / 载入",
            "keys": [
                "preset-name",
                "save-preset",
                "load-preset",
                "delete-preset",
                "open-presets-folder"
            ]
        },
        "s-preset-maint": {
            "type": "section",
            "title": "维护",
            "keys": [
                "reset-theme",
                "restore-original",
                "uninstall-themes"
            ]
        },
        "p-maint": {
            "type": "page",
            "title": "说明",
            "sections": [
                "s-about",
                "s-notes",
                "s-doc"
            ]
        },
        "s-about": {
            "type": "section",
            "title": "工作方式",
            "keys": [
                "about-flow"
            ]
        },
        "s-notes": {
            "type": "section",
            "title": "其他",
            "keys": [
                "note-variant",
                "note-terminal",
                "note-working",
                "note-refresh"
            ]
        },
        "s-doc": {
            "type": "section",
            "title": "文档",
            "keys": [
                "open-readme"
            ]
        }
    },
    "variant": {
        "type": "combobox",
        "default": "Nebula-Dark",
        "description": "主题变体",
        "tooltip": "选择要调整哪一套主题。生成结果写入 ~/.themes/Nebula-Dark-Studio 或 ~/.themes/Nebula-Light-Studio",
        "options": {
            "Nebula-Dark（深色）": "Nebula-Dark",
            "Nebula-Light（浅色）": "Nebula-Light"
        }
    },
    "terminal-palette": {
        "type": "combobox",
        "default": "system",
        "description": "终端配色（ANSI 16 色）",
        "tooltip": "写到 gnome-terminal 的全部配置档案。只改 ANSI 16 色，终端的前景色/背景色仍跟随 GTK 主题，所以半透明终端的搭配不受影响。已打开的终端窗口不会变色，需要新开一个。",
        "options": {
            "跟随系统（不干预）": "system",
            "Nebula 深色": "nebula-dark",
            "Nebula 浅色": "nebula-light",
            "中性通用": "neutral"
        }
    },
    "terminal-opacity": {
        "type": "scale",
        "default": 100,
        "min": 20,
        "max": 100,
        "step": 5,
        "units": "%",
        "show-value": true,
        "description": "终端输入区不透明度",
        "tooltip": "100% = 强制完全不透明。滑杆顶到头会真的把终端输入区写成不透明，而不是「恢复原样」—— 想回到你原本的配置，用维护里的「恢复原始主题」。只改输入区背景，不碰前景色、字体、光标。新开的终端窗口才能看到。",
        "digits": 0
    },
    "auto-apply": {
        "type": "switch",
        "default": false,
        "description": "参数变化后自动重新生成并应用",
        "tooltip": "关闭时需要手动点击「生成并应用」。打开后拖动滑块会在停顿约 0.35 秒后自动应用。"
    },
    "apply-now": {
        "type": "button",
        "default": "",
        "description": "生成并应用",
        "callback": "onApplyNow"
    },
    "panel-opacity": {
        "type": "scale",
        "default": 70,
        "min": 30,
        "max": 100,
        "step": 5,
        "units": "%",
        "show-value": true,
        "description": "面板不透明度",
        "tooltip": "顶栏/底栏/侧栏，以及 GTK 应用的标题栏、工具栏、菜单栏",
        "digits": 0
    },
    "menu-opacity": {
        "type": "scale",
        "default": 80,
        "min": 20,
        "max": 100,
        "step": 5,
        "units": "%",
        "show-value": true,
        "description": "菜单 / 弹出层不透明度",
        "tooltip": "开始菜单、右键菜单、通知、日历、OSD、提示气泡",
        "digits": 0
    },
    "window-opacity": {
        "type": "scale",
        "default": 90,
        "min": 30,
        "max": 100,
        "step": 5,
        "units": "%",
        "show-value": true,
        "description": "窗口底色不透明度",
        "tooltip": "GTK 窗口主背景、概览遮罩、对话框底",
        "digits": 0
    },
    "hover-opacity": {
        "type": "scale",
        "default": 60,
        "min": 20,
        "max": 100,
        "step": 5,
        "units": "%",
        "show-value": true,
        "description": "悬停 / 按下态不透明度",
        "tooltip": "鼠标悬停、按下、选中项的高亮底色",
        "digits": 0
    },
    "selection-alpha": {
        "type": "scale",
        "default": 15,
        "min": 5,
        "max": 60,
        "step": 1,
        "units": "%",
        "show-value": true,
        "description": "强调淡底浓度",
        "tooltip": "菜单选中行、启动器选中项等「淡强调底」的浓淡。切换变体时会自动改为该变体的默认值（深色 15% / 浅色 20%）。不影响强调描边与焦点环。",
        "digits": 0
    },
    "bg-color": {
        "type": "colorchooser",
        "default": "rgb(13,17,23)",
        "description": "主背景色",
        "tooltip": "窗口、输入框、菜单内容的底色。只替换背景类位置：按钮上的文字、白色高光与焦点环等前景语义保持原样。底色的浓淡仍由「窗口底色不透明度」控制。"
    },
    "panel-color": {
        "type": "colorchooser",
        "default": "rgb(28,33,40)",
        "description": "面板背景色",
        "tooltip": "Cinnamon 面板、GTK 标题栏/工具栏/菜单栏的底色。底色的浓淡仍由「面板不透明度」控制。"
    },
    "menu-color": {
        "type": "colorchooser",
        "default": "rgb(22,27,34)",
        "description": "菜单背景色",
        "tooltip": "开始菜单、右键弹窗、提示气泡等浮层的底色。底色的浓淡仍由「菜单不透明度」控制。"
    },
    "accent-color": {
        "type": "colorchooser",
        "default": "rgb(88,166,255)",
        "description": "强调色",
        "tooltip": "选中、焦点环、进度条、开关、建议按钮"
    },
    "border-color": {
        "type": "colorchooser",
        "default": "rgb(48,54,61)",
        "description": "边框色",
        "tooltip": "控件描边、分隔线、滚动条槽。透明度保持主题原样。"
    },
    "fg-color": {
        "type": "colorchooser",
        "default": "rgb(230,237,243)",
        "description": "主文字色"
    },
    "fg-dim-color": {
        "type": "colorchooser",
        "default": "rgb(139,148,158)",
        "description": "次级文字色",
        "tooltip": "禁用态、说明文字、未聚焦窗口标题"
    },
    "danger-color": {
        "type": "colorchooser",
        "default": "rgb(248,81,73)",
        "description": "危险色",
        "tooltip": "删除、关机、破坏性操作按钮"
    },
    "warn-color": {
        "type": "colorchooser",
        "default": "rgb(210,153,34)",
        "description": "警告色",
        "tooltip": "提示条、结束会话确认"
    },
    "success-color": {
        "type": "colorchooser",
        "default": "rgb(63,185,80)",
        "description": "成功色"
    },
    "window-radius": {
        "type": "scale",
        "default": 12,
        "min": 0,
        "max": 24,
        "step": 1,
        "show-value": true,
        "description": "窗口 / 菜单圆角（px）",
        "tooltip": "菜单、弹出层、提示、OSD、GTK 窗口与装饰的圆角。标题栏自身的「上圆下方」形状保持不变。",
        "digits": 0
    },
    "control-radius": {
        "type": "scale",
        "default": 6,
        "min": 0,
        "max": 16,
        "step": 1,
        "show-value": true,
        "description": "控件圆角（px）",
        "tooltip": "按钮、输入框、菜单项、面板按钮等小控件",
        "digits": 0
    },
    "base-font-size": {
        "type": "spinbutton",
        "default": 10,
        "min": 8,
        "max": 14,
        "step": 1,
        "units": "pt",
        "description": "Cinnamon 基准字号（pt）",
        "tooltip": "以 10pt 为基准等比缩放 Cinnamon 面板与菜单里的所有字号。GTK 应用字号由应用自身/系统字体设置决定，不受影响。"
    },
    "preset-name": {
        "type": "entry",
        "default": "",
        "description": "方案名",
        "tooltip": "保存 / 载入 / 删除都以此处的名称为准，支持中文"
    },
    "save-preset": {
        "type": "button",
        "default": "",
        "description": "保存为方案（生成可切换的主题）",
        "callback": "onSavePreset"
    },
    "load-preset": {
        "type": "button",
        "default": "",
        "description": "载入方案并应用",
        "callback": "onLoadPreset"
    },
    "delete-preset": {
        "type": "button",
        "default": "",
        "description": "删除方案及其主题目录",
        "callback": "onDeletePreset"
    },
    "open-presets-folder": {
        "type": "button",
        "default": "",
        "description": "打开方案目录",
        "callback": "onOpenPresetsFolder"
    },
    "reset-theme": {
        "type": "button",
        "default": "",
        "description": "重置本主题为默认值",
        "callback": "onResetTheme"
    },
    "restore-original": {
        "type": "button",
        "default": "",
        "description": "恢复原始主题并删除生成结果",
        "callback": "onRestoreOriginal"
    },
    "uninstall-themes": {
        "type": "button",
        "default": "",
        "description": "卸载扩展安装的两个主题",
        "callback": "onUninstallThemes"
    },
    "about-flow": {
        "type": "label",
        "default": "",
        "description": "启用扩展会把两个源主题装进 ~/.themes（已存在则跳过，不覆盖你自己的改动）。「生成并应用」产出工作主题，「保存为方案」产出独立存档主题，两者都与普通主题并列，可随时选用与删除；源主题始终不被修改。"
    },
    "note-variant": {
        "type": "label",
        "default": "",
        "description": "两个变体的参数各自记忆：切走时自动存档，切回时整套恢复。首次切到某变体时，仍是默认值的颜色会迁移到该变体的默认色。"
    },
    "note-terminal": {
        "type": "label",
        "default": "",
        "description": "终端配色选「跟随系统」完全不干预，被覆盖过则切回即还原。输入区不透明度相反：顶到 100% 会强制写成完全不透明，接管前的原值记在状态文件里，可用「恢复原始主题」还回去。两项都只在「生成并应用」时写入，新开终端窗口才看得到。"
    },
    "note-working": {
        "type": "label",
        "default": "",
        "description": "工作主题 Nebula-<变体>-Studio 是试参数的地方，下次生成就覆盖；「保存为方案」才冻结出独立命名的存档主题，方案存于 ~/.config/nebula-theme-studio/presets/，支持中文名，各方案互不覆盖。方案名留空时会提示已有方案列表。"
    },
    "note-refresh": {
        "type": "label",
        "default": "",
        "description": "面板与菜单由 Cinnamon 即时重载；已打开的 GTK 应用通过一次中转切换强制刷新，个别应用仍会缓存，重开即可。"
    },
    "open-readme": {
        "type": "custom",
        "file": "readme_button.py",
        "widget": "ReadmeButton",
        "description": "打开 README 文档"
    }
}
