#. tiler.js:1095
msgid "Main Left"
msgstr "Principal izq."

#. tiler.js:1097
msgid ""
"The focused window fills the left half, and the rest stack on the right."
msgstr ""
"La ventana enfocada ocupa la mitad izquierda y las demás se apilan a la "
"derecha."

#. tiler.js:1102
msgid "Main Right"
msgstr "Principal dcha."

#. tiler.js:1104
msgid ""
"The focused window fills the right half, and the rest stack on the left."
msgstr ""
"La ventana enfocada ocupa la mitad derecha y las demás se apilan a la "
"izquierda."

#. tiler.js:1109
msgid "Equal Left"
msgstr "Igual izq."

#. tiler.js:1111
msgid "Every window shares two equal columns, led from the top left."
msgstr ""
"Todas las ventanas se reparten en dos columnas iguales, empezando por arriba "
"a la izquierda."

#. tiler.js:1116
msgid "Equal Right"
msgstr "Igual dcha."

#. tiler.js:1118
msgid "Every window shares two equal columns, led from the top right."
msgstr ""
"Todas las ventanas se reparten en dos columnas iguales, empezando por arriba "
"a la derecha."

