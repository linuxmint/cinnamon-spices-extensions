#. tiler.js:1095
msgid "Main Left"
msgstr "Principale gauche"

#. tiler.js:1097
msgid ""
"The focused window fills the left half, and the rest stack on the right."
msgstr ""
"La fenêtre active occupe la moitié gauche et les autres s'empilent à droite."

#. tiler.js:1102
msgid "Main Right"
msgstr "Principale droite"

#. tiler.js:1104
msgid ""
"The focused window fills the right half, and the rest stack on the left."
msgstr ""
"La fenêtre active occupe la moitié droite et les autres s'empilent à gauche."

#. tiler.js:1109
msgid "Equal Left"
msgstr "Égal gauche"

#. tiler.js:1111
msgid "Every window shares two equal columns, led from the top left."
msgstr ""
"Toutes les fenêtres se partagent deux colonnes égales, en partant du haut à "
"gauche."

#. tiler.js:1116
msgid "Equal Right"
msgstr "Égal droite"

#. tiler.js:1118
msgid "Every window shares two equal columns, led from the top right."
msgstr ""
"Toutes les fenêtres se partagent deux colonnes égales, en partant du haut à "
"droite."

