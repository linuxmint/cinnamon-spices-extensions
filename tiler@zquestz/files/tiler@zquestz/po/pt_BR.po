#. tiler.js:948
msgid "Main Left"
msgstr "Principal esq."

#. tiler.js:949
msgid ""
"The focused window fills the left half, and the rest stack on the right."
msgstr ""
"A janela em foco ocupa a metade esquerda e as demais se empilham à direita."

#. tiler.js:953
msgid "Main Right"
msgstr "Principal dir."

#. tiler.js:954
msgid ""
"The focused window fills the right half, and the rest stack on the left."
msgstr ""
"A janela em foco ocupa a metade direita e as demais se empilham à esquerda."

#. tiler.js:958
msgid "Equal Left"
msgstr "Igual esq."

#. tiler.js:959
msgid "Every window shares two equal columns, led from the top left."
msgstr ""
"Todas as janelas dividem duas colunas iguais, começando do canto superior "
"esquerdo."

#. tiler.js:963
msgid "Equal Right"
msgstr "Igual dir."

#. tiler.js:964
msgid "Every window shares two equal columns, led from the top right."
msgstr ""
"Todas as janelas dividem duas colunas iguais, começando do canto superior "
"direito."

