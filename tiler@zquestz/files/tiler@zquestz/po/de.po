#. tiler.js:1095
msgid "Main Left"
msgstr "Haupt links"

#. tiler.js:1097
msgid ""
"The focused window fills the left half, and the rest stack on the right."
msgstr ""
"Das fokussierte Fenster füllt die linke Hälfte, der Rest stapelt sich rechts."

#. tiler.js:1102
msgid "Main Right"
msgstr "Haupt rechts"

#. tiler.js:1104
msgid ""
"The focused window fills the right half, and the rest stack on the left."
msgstr ""
"Das fokussierte Fenster füllt die rechte Hälfte, der Rest stapelt sich links."

#. tiler.js:1109
msgid "Equal Left"
msgstr "Gleich links"

#. tiler.js:1111
msgid "Every window shares two equal columns, led from the top left."
msgstr "Alle Fenster teilen sich zwei gleiche Spalten, angeführt oben links."

#. tiler.js:1116
msgid "Equal Right"
msgstr "Gleich rechts"

#. tiler.js:1118
msgid "Every window shares two equal columns, led from the top right."
msgstr "Alle Fenster teilen sich zwei gleiche Spalten, angeführt oben rechts."

