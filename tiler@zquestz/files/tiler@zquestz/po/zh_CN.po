#. tiler.js:948
msgid "Main Left"
msgstr "左主窗"

#. tiler.js:949
msgid ""
"The focused window fills the left half, and the rest stack on the right."
msgstr "当前窗口占据左半屏，其余窗口在右侧堆叠。"

#. tiler.js:953
msgid "Main Right"
msgstr "右主窗"

#. tiler.js:954
msgid ""
"The focused window fills the right half, and the rest stack on the left."
msgstr "当前窗口占据右半屏，其余窗口在左侧堆叠。"

#. tiler.js:958
msgid "Equal Left"
msgstr "左均分"

#. tiler.js:959
msgid "Every window shares two equal columns, led from the top left."
msgstr "所有窗口均分两列，从左上角开始排列。"

#. tiler.js:963
msgid "Equal Right"
msgstr "右均分"

#. tiler.js:964
msgid "Every window shares two equal columns, led from the top right."
msgstr "所有窗口均分两列，从右上角开始排列。"

