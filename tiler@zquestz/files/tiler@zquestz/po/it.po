#. tiler.js:948
msgid "Main Left"
msgstr "Principale sx"

#. tiler.js:949
msgid ""
"The focused window fills the left half, and the rest stack on the right."
msgstr ""
"La finestra attiva occupa la metà sinistra e le altre si impilano a destra."

#. tiler.js:953
msgid "Main Right"
msgstr "Principale dx"

#. tiler.js:954
msgid ""
"The focused window fills the right half, and the rest stack on the left."
msgstr ""
"La finestra attiva occupa la metà destra e le altre si impilano a sinistra."

#. tiler.js:958
msgid "Equal Left"
msgstr "Uguale sx"

#. tiler.js:959
msgid "Every window shares two equal columns, led from the top left."
msgstr ""
"Tutte le finestre condividono due colonne uguali, a partire dall'alto a "
"sinistra."

#. tiler.js:963
msgid "Equal Right"
msgstr "Uguale dx"

#. tiler.js:964
msgid "Every window shares two equal columns, led from the top right."
msgstr ""
"Tutte le finestre condividono due colonne uguali, a partire dall'alto a "
"destra."

