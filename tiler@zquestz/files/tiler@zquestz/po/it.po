#. metadata.json->name
msgid "Tiler"
msgstr "Tiler"

#. metadata.json->description
msgid ""
"Grid-based window tiling with gaps, reserved screen space, and one-press "
"auto-tiling. Inspired by gTile."
msgstr ""
"Disposizione delle finestre a griglia con spaziature, spazio riservato sullo "
"schermo e disposizione automatica con un solo tasto. Ispirato a gTile."

#. settings-schema.json->general-page->title
msgid "General"
msgstr "Generale"

#. settings-schema.json->spacing-page->title
msgid "Spacing"
msgstr "Spaziatura"

#. settings-schema.json->hotkeys-section->title
msgid "Hotkeys"
msgstr "Scorciatoie"

#. settings-schema.json->tiling-section->title
msgid "Tiling options"
msgstr "Opzioni di disposizione"

#. settings-schema.json->gaps-section->title
msgid "Gaps"
msgstr "Spazi"

#. settings-schema.json->reserved-section->title
msgid "Reserved space"
msgstr "Spazio riservato"

#. settings-schema.json->grids-page->title
msgid "Grids"
msgstr "Griglie"

#. settings-schema.json->grid-1-section->title
msgid "Grid 1"
msgstr "Griglia 1"

#. settings-schema.json->grid-2-section->title
msgid "Grid 2"
msgstr "Griglia 2"

#. settings-schema.json->grid-3-section->title
msgid "Grid 3"
msgstr "Griglia 3"

#. settings-schema.json->grid-4-section->title
msgid "Grid 4"
msgstr "Griglia 4"

#. settings-schema.json->keybindings-section->title
msgid "Keybindings"
msgstr "Associazioni dei tasti"

#. settings-schema.json->hotkey->description
msgid "Tile the focused window"
msgstr "Disponi la finestra attiva"

#. settings-schema.json->hotkey->tooltip
msgid "Keyboard shortcut that opens Tiler for the focused window."
msgstr "Scorciatoia da tastiera che apre Tiler per la finestra attiva."

#. settings-schema.json->center-on-window->description
msgid "Center the grid on the focused window"
msgstr "Centra la griglia sulla finestra attiva"

#. settings-schema.json->center-on-window->tooltip
msgid ""
"The grid normally appears in the middle of the screen. Turn this on to have "
"it appear over the window being tiled instead."
msgstr ""
"Di norma la griglia compare al centro dello schermo. Attiva questa opzione "
"per farla comparire sopra la finestra da disporre."

#. settings-schema.json->tile-dialogs->description
msgid "Tile dialog windows"
msgstr "Disponi le finestre di dialogo"

#. settings-schema.json->tile-dialogs->tooltip
msgid ""
"Ordinary windows are always tiled. This adds dialogs such as preferences and "
"file choosers; dialogs that cannot be resized are skipped."
msgstr ""
"Le finestre normali vengono sempre disposte. Questo aggiunge le finestre di "
"dialogo come preferenze e selettori di file; i dialoghi non ridimensionabili "
"vengono ignorati."

#. settings-schema.json->tile-toolboxes->description
msgid "Tile toolboxes and palettes"
msgstr "Disponi pannelli degli strumenti e tavolozze"

#. settings-schema.json->tile-toolboxes->tooltip
msgid "Floating tool windows, like the ones used by image editors."
msgstr "Finestre degli strumenti mobili, come quelle degli editor di immagini."

#. settings-schema.json->show-autotile->description
msgid "Show auto-tile actions on the grid"
msgstr "Mostra le azioni di disposizione automatica sulla griglia"

#. settings-schema.json->show-autotile->tooltip
msgid ""
"Adds a row of arrangements to the grid that tile every window on the "
"workspace at once: a main window beside a stack, or everything shared out "
"equally."
msgstr ""
"Aggiunge alla griglia una fila di disposizioni che sistemano in una volta "
"tutte le finestre dello spazio di lavoro: una finestra principale accanto a "
"una pila, oppure tutto suddiviso in parti uguali."

#. settings-schema.json->window-gap->units
#. settings-schema.json->edge-gap->units
#. settings-schema.json->reserved-top->units
#. settings-schema.json->reserved-bottom->units
#. settings-schema.json->reserved-left->units
#. settings-schema.json->reserved-right->units
msgid "pixels"
msgstr "pixel"

#. settings-schema.json->window-gap->description
msgid "Gap between windows"
msgstr "Spazio tra le finestre"

#. settings-schema.json->window-gap->tooltip
msgid "Space left between two windows tiled next to each other."
msgstr "Spazio lasciato tra due finestre disposte una accanto all'altra."

#. settings-schema.json->edge-gap->description
msgid "Gap at screen edges"
msgstr "Spazio ai bordi dello schermo"

#. settings-schema.json->edge-gap->tooltip
msgid ""
"Space left between a tiled window and the edge of the usable screen area."
msgstr ""
"Spazio lasciato tra una finestra disposta e il bordo dell'area utilizzabile "
"dello schermo."

#. settings-schema.json->reserved-scope->description
msgid "Reserve space on"
msgstr "Riserva spazio su"

#. settings-schema.json->reserved-scope->tooltip
msgid ""
"Choose whether reserved space applies to every monitor or only the primary "
"monitor."
msgstr ""
"Scegli se lo spazio riservato vale per tutti i monitor o solo per quello "
"principale."

#. settings-schema.json->reserved-scope->options
msgid "All monitors"
msgstr "Tutti i monitor"

#. settings-schema.json->reserved-scope->options
msgid "Primary monitor only"
msgstr "Solo il monitor principale"

#. settings-schema.json->reserved-top->description
msgid "Reserved space at the top"
msgstr "Spazio riservato in alto"

#. settings-schema.json->reserved-top->tooltip
#. settings-schema.json->reserved-bottom->tooltip
#. settings-schema.json->reserved-left->tooltip
#. settings-schema.json->reserved-right->tooltip
msgid ""
"Windows are never tiled into this area. Useful for Conky or docks that do "
"not reserve space themselves."
msgstr ""
"Le finestre non vengono mai disposte in quest'area. Utile per Conky o per i "
"dock che non riservano spazio da soli."

#. settings-schema.json->reserved-bottom->description
msgid "Reserved space at the bottom"
msgstr "Spazio riservato in basso"

#. settings-schema.json->reserved-left->description
msgid "Reserved space on the left"
msgstr "Spazio riservato a sinistra"

#. settings-schema.json->reserved-right->description
msgid "Reserved space on the right"
msgstr "Spazio riservato a destra"

#. settings-schema.json->grid-1-cols->units
#. settings-schema.json->grid-2-cols->units
#. settings-schema.json->grid-3-cols->units
#. settings-schema.json->grid-4-cols->units
msgid "columns"
msgstr "colonne"

#. settings-schema.json->grid-1-cols->description
#. settings-schema.json->grid-2-cols->description
#. settings-schema.json->grid-3-cols->description
#. settings-schema.json->grid-4-cols->description
msgid "Columns"
msgstr "Colonne"

#. settings-schema.json->grid-1-cols->tooltip
#. settings-schema.json->grid-2-cols->tooltip
#. settings-schema.json->grid-3-cols->tooltip
#. settings-schema.json->grid-4-cols->tooltip
msgid "How many columns this grid is divided into."
msgstr "In quante colonne è divisa questa griglia."

#. settings-schema.json->grid-1-rows->units
#. settings-schema.json->grid-2-rows->units
#. settings-schema.json->grid-3-rows->units
#. settings-schema.json->grid-4-rows->units
msgid "rows"
msgstr "righe"

#. settings-schema.json->grid-1-rows->description
#. settings-schema.json->grid-2-rows->description
#. settings-schema.json->grid-3-rows->description
#. settings-schema.json->grid-4-rows->description
msgid "Rows"
msgstr "Righe"

#. settings-schema.json->grid-1-rows->tooltip
#. settings-schema.json->grid-2-rows->tooltip
#. settings-schema.json->grid-3-rows->tooltip
#. settings-schema.json->grid-4-rows->tooltip
msgid "How many rows this grid is divided into."
msgstr "In quante righe è divisa questa griglia."

#. settings-schema.json->grid-1-layout->description
#. settings-schema.json->grid-2-layout->description
#. settings-schema.json->grid-3-layout->description
#. settings-schema.json->grid-4-layout->description
msgid "Layout"
msgstr "Disposizione"

#. settings-schema.json->grid-1-layout->tooltip
#. settings-schema.json->grid-2-layout->tooltip
#. settings-schema.json->grid-3-layout->tooltip
#. settings-schema.json->grid-4-layout->tooltip
msgid ""
"Columns, then rows. Sizes can be given one by one to make some tracks larger "
"than others, so 1,2,1 x 1,1 is three columns whose middle one is twice the "
"width of its neighbours. Changing the numbers above rewrites this, and "
"anything that cannot be read falls back to them."
msgstr ""
"Colonne, poi righe. Le dimensioni possono essere indicate una per una per "
"rendere alcune tracce più grandi: 1,2,1 x 1,1 sono tre colonne la cui "
"centrale è larga il doppio delle vicine. Cambiare i numeri sopra riscrive "
"questo campo, e ciò che non si può interpretare ricade su di essi."

#. settings-schema.json->grid-1-name->description
#. settings-schema.json->grid-2-name->description
#. settings-schema.json->grid-3-name->description
#. settings-schema.json->grid-4-name->description
msgid "Name"
msgstr "Nome"

#. settings-schema.json->grid-1-name->tooltip
#. settings-schema.json->grid-2-name->tooltip
#. settings-schema.json->grid-3-name->tooltip
#. settings-schema.json->grid-4-name->tooltip
msgid ""
"What this grid is called on the grid selector. Long names are shortened to "
"fit. Left empty, it is named after its size."
msgstr ""
"Il nome di questa griglia nel selettore. I nomi lunghi vengono accorciati. "
"Se lasciato vuoto, prende il nome dalla sua dimensione."

#. settings-schema.json->grid-1-tooltip->description
#. settings-schema.json->grid-2-tooltip->description
#. settings-schema.json->grid-3-tooltip->description
#. settings-schema.json->grid-4-tooltip->description
msgid "Description"
msgstr "Descrizione"

#. settings-schema.json->grid-1-tooltip->tooltip
#. settings-schema.json->grid-2-tooltip->tooltip
#. settings-schema.json->grid-3-tooltip->tooltip
#. settings-schema.json->grid-4-tooltip->tooltip
msgid "Shown when hovering this grid on the selector."
msgstr "Mostrato al passaggio del mouse su questa griglia nel selettore."
