#. metadata.json->name
msgid "Keyboard layout search"
msgstr ""

#. metadata.json->description
msgid ""
"Find applications in the menu by the keys you pressed, whatever keyboard "
"layout is active. Type a program's name with the wrong layout selected and "
"the menu still finds it, because the query is retyped into every layout you "
"have enabled."
msgstr ""

#. settings-schema.json->head-matching->description
msgid "Matching"
msgstr ""

#. settings-schema.json->min-chars->units
msgid "characters"
msgstr ""

#. settings-schema.json->min-chars->description
msgid "Minimum query length"
msgstr ""

#. settings-schema.json->min-chars->tooltip
msgid ""
"A one or two letter query, retyped into another layout, matches almost "
"everything. Raise this if the menu feels noisy."
msgstr ""

#. settings-schema.json->max-results->units
msgid "results"
msgstr ""

#. settings-schema.json->max-results->description
msgid "Maximum extra results"
msgstr ""

#. settings-schema.json->max-results->tooltip
msgid ""
"How many wrong-layout matches to add. Results found in the layout you "
"actually typed in are never limited."
msgstr ""

#. settings-schema.json->skip-when-native-matches->description
msgid "Only search other layouts when the menu found nothing"
msgstr ""

#. settings-schema.json->skip-when-native-matches->tooltip
msgid ""
"Keeps the list short, at the cost of hiding a wrong-layout match whenever "
"the query also happens to match something in the current layout."
msgstr ""

#. settings-schema.json->head-fields->description
msgid "Fields searched"
msgstr ""

#. settings-schema.json->match-keywords->description
msgid "Application keywords"
msgstr ""

#. settings-schema.json->match-description->description
msgid "Application descriptions"
msgstr ""

#. settings-schema.json->match-description->tooltip
msgid "Descriptions are long, so they match more loosely than names do."
msgstr ""

#. settings-schema.json->match-desktop-id->description
msgid "Desktop file names"
msgstr ""

#. settings-schema.json->match-desktop-id->tooltip
msgid ""
"Matches names like dev.vencord.Vesktop.desktop, which is often what a "
"launcher is really called."
msgstr ""
