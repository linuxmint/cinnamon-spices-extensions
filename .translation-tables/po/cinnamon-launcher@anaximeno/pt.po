#. metadata.json->name
msgid "Cinnamon App Launcher"
msgstr "Lançador de Aplicações do Cinnamon"

#. metadata.json->description
msgid "A centered, search-first launcher for cinnamon."
msgstr ""
"Um lançador centrado, com a pesquisa em primeiro plano, para o Cinnamon."

#. 6.4->settings-schema.json->main-page->title
#. 6.4->settings-schema.json->general-section->title
msgid "General"
msgstr "Geral"

#. 6.4->settings-schema.json->search-section->title
msgid "Search"
msgstr "Pesquisa"

#. 6.4->settings-schema.json->open-launcher->description
msgid "Open launcher keybinding"
msgstr "Atalho para abrir o lançador"

#. 6.4->settings-schema.json->fuzzy-search->description
msgid "Use fuzzy search"
msgstr "Usar pesquisa difusa"

#. 6.4->settings-schema.json->fuzzy-search->tooltip
msgid ""
"Matches letters in any order, like Alfred/Raycast. Disable for plain "
"substring search, like the Cinnamon Menu."
msgstr ""
"Corresponde a letras em qualquer ordem, tal como no Alfred/Raycast. Desative "
"para uma pesquisa simples por substring, como no Menu do Cinnamon."

#. 6.4->settings-schema.json->enable-calculator->description
msgid "Enable the inline calculator"
msgstr "Ativar a calculadora integrada"

#. 6.4->settings-schema.json->enable-calculator->tooltip
msgid ""
"Typing a sum like 12*(3+4) shows the result; Enter copies it to the "
"clipboard."
msgstr ""
"Escrever uma soma como 12*(3+4) mostra o resultado; o Enter copia-o para a "
"área de transferência."

#. 6.4->settings-schema.json->enable-system-actions->description
msgid "Show system actions"
msgstr "Mostrar ações do sistema"

#. 6.4->settings-schema.json->enable-system-actions->tooltip
msgid ""
"Lock Screen, Log Out, Shut Down and Open Settings, searchable from the same "
"box."
msgstr ""
"Bloquear Ecrã, Terminar Sessão, Desligar e Abrir Definições, pesquisáveis na "
"mesma caixa."

#. 6.4->settings-schema.json->show-frequent-apps->description
msgid "Show frequently used applications when the launcher opens"
msgstr "Mostrar aplicações utilizadas com frequência ao abrir o lançador"

#. 6.4->settings-schema.json->show-frequent-apps->tooltip
msgid ""
"Launches are tracked locally to rank frequently used applications. Disabling "
"this stops tracking and deletes the recorded usage history."
msgstr ""
"Lançamentos são monitorados localmente para rankear aplicações usadas "
"frequentementes. Desativar isto para o monitoramento e elimina o histórico."

#. 6.4->settings-schema.json->max-frequent-apps->description
msgid "Maximum number of frequently used applications to show"
msgstr "Número máximo de aplicações frequentes a mostrar"

#. 6.4->settings-schema.json->show-descriptions->description
msgid "Show descriptions under each result"
msgstr "Mostrar descrições sob cada resultado"

#. 6.4->settings-schema.json->enable-animations->description
msgid "Enable animations"
msgstr "Ativar animações"

#. 6.4->settings-schema.json->launcher-scale->description
msgid "Launcher size"
msgstr "Tamanho do lançador"

#. 6.4->settings-schema.json->launcher-scale->tooltip
msgid "Overall size of the launcher window, independent of display scaling."
msgstr ""
"Tamanho geral da janela do lançador, independente do escalamento do ecrã."

#. 6.4->settings-schema.json->launcher-scale->options
msgid "Small"
msgstr "Pequeno"

#. 6.4->settings-schema.json->launcher-scale->options
msgid "Medium"
msgstr "Médio"

#. 6.4->settings-schema.json->launcher-scale->options
msgid "Large"
msgstr "Grande"
