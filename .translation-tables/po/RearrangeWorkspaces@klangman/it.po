#, javascript-format
msgid ""
"Moved workspace to the left\n"
"Workspace is now at position %s"
msgstr ""
"Area di lavoro spostata a sinistra.\n"
"L'area di lavoro si trova ora nella posizione %s"

#. 5.4/extension.js:127 5.4/extension.js:136
#, javascript-format
msgid ""
"Moved workspace to the right\n"
"Workspace is now at position %s"
msgstr ""
"Area di lavoro spostata a destra.\n"
"L'area di lavoro si trova ora nella posizione %s."

#. metadata.json->name
msgid "Rearrange Workspaces"
msgstr "Riorganizza gli spazi di lavoro"

#. metadata.json->description
msgid "Allows you to rearrange Cinnamon desktop workspaces"
msgstr ""
"Consente di riorganizzare gli spazi di lavoro del desktop Cinnamon"

#. 5.4->settings-schema.json->keybinding-header->description
msgid "Hotkeys to move the current workspace"
msgstr ""
"Tasti di scelta rapida per spostare l'area di lavoro corrente"

#. 5.4->settings-schema.json->left-key->description
msgid "Move workspace to the left"
msgstr "Sposta l'area di lavoro a sinistra"

#. 5.4->settings-schema.json->right-key->description
msgid "Move workspace to the right"
msgstr "Sposta l'area di lavoro a destra"
