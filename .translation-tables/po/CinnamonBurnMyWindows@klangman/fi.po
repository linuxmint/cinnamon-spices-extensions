#. 6.7.6->settings-schema.json->aperture-panels-flip-axis->options
#. 6.7.6->settings-schema.json->magiclamp-effect->options
msgid "Random"
msgstr "Satunnainen"

#. 6.2->settings-schema.json->aperture-panels-wave-shape->description
#. 6.7.6->settings-schema.json->aperture-panels-wave-shape->description
msgid "Wave Shape"
msgstr "Aallon muoto"

#. 6.2->settings-schema.json->aperture-panels-wave-shape->tooltip
#. 6.7.6->settings-schema.json->aperture-panels-wave-shape->tooltip
msgid ""
"The shape of the wave of panels flipping across the window. Random picks one "
"of the shapes for each animation."
msgstr ""
"Paneelien aaltomainen liike ikkunan yli. Valitsee satunnaisesti yhden näistä "
"muodoista kutakin animaatiota varten."

#. 6.2->settings-schema.json->aperture-panels-flip-axis->options
#. 6.7.6->settings-schema.json->aperture-panels-flip-axis->options
msgid "Vertical"
msgstr "Pystysuora"

#. 6.2->settings-schema.json->aperture-panels-flip-axis->options
#. 6.7.6->settings-schema.json->aperture-panels-flip-axis->options
msgid "Horizontal"
msgstr "Vaakasuora"

#. 6.2->settings-schema.json->aperture-panels-flip-axis->description
#. 6.7.6->settings-schema.json->aperture-panels-flip-axis->description
msgid "Flip Axis"
msgstr "Käännä akseli"

#. 6.2->settings-schema.json->aperture-panels-flip-axis->tooltip
#. 6.7.6->settings-schema.json->aperture-panels-flip-axis->tooltip
msgid "The axis the panels turn around. Random picks one for each animation."
msgstr ""
"Akseli, jonka ympäri paneelit pyörivät.Valitsee satunnaisesti yhden kutakin "
"animaatiota varten."

#. 6.2->settings-schema.json->aperture-panels-backdrop->options
#. 6.7.6->settings-schema.json->aperture-panels-backdrop->options
