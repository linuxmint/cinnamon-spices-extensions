#. 6.2->settings-schema.json->aperture-panels-border-style->options
#. 6.7.6->settings-schema.json->aperture-panels-border-style->options
msgid "Behind the wave"
msgstr "Aallon takana"

#. 6.2->settings-schema.json->aperture-panels-border-style->options
#. 6.7.6->settings-schema.json->aperture-panels-border-style->options
msgid "Ahead of and behind the wave"
msgstr "Aallon edellä ja takana"

#. 6.2->settings-schema.json->aperture-panels-border-style->description
#. 6.7.6->settings-schema.json->aperture-panels-border-style->description
msgid "Border Style"
msgstr "Reunatyyli"

#. 6.2->settings-schema.json->aperture-panels-border-style->tooltip
#. 6.7.6->settings-schema.json->aperture-panels-border-style->tooltip
msgid ""
"When the outlines of the panels are shown: only while a panel flips, or also "
"in a band ahead of and/or behind the wave of flipping panels."
msgstr ""
"Kun paneelien ääriviivat näytetään: vain paneelin kääntyessä tai myös "
"kääntyvien paneelien aallon edellä ja/tai takana."

