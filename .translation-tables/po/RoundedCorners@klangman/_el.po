#. 6.0->settings-schema.json->shadow-color-mode->options
msgid "Black"
msgstr ""

#. 6.0->settings-schema.json->shadow-color-mode->options
msgid "Single colour"
msgstr ""

#. 6.0->settings-schema.json->shadow-color-mode->options
msgid "Gradient"
msgstr ""

#. 6.0->settings-schema.json->shadow-color-mode->options
msgid "Rainbow"
msgstr ""

#. 6.0->settings-schema.json->shadow-color-mode->tooltip
msgid ""
"Black is a normal shadow. The other options colour it; with some glow and no "
"vertical offset they look more like a coloured light around the window."
msgstr ""

#. 6.0->settings-schema.json->shadow-color->description
msgid "Colour (gradient start)"
msgstr ""

#. 6.0->settings-schema.json->shadow-color->tooltip
msgid ""
"Used by Single colour, and as the gradient's start colour. Not used by "
"Rainbow."
msgstr ""

#. 6.0->settings-schema.json->shadow-color-2->description
msgid "Gradient end colour"
msgstr ""

#. 6.0->settings-schema.json->shadow-gradient-angle->description
msgid "Gradient direction"
msgstr ""

#. 6.0->settings-schema.json->shadow-gradient-angle->units
msgid "degrees"
msgstr ""

#. 6.0->settings-schema.json->shadow-gradient-angle->tooltip
msgid "0 runs from left to right, 90 from top to bottom."
msgstr ""

#. 6.0->settings-schema.json->shadow-glow->description
msgid "Glow"
msgstr ""

#. 6.0->settings-schema.json->shadow-glow->tooltip
msgid ""
"How much the colour adds light to what's behind it instead of covering it. 0 "
"looks like a coloured shadow, 100 like a neon glow."
msgstr ""

#. 6.0->settings-schema.json->shadow-rainbow-turn-time->description
msgid "Rainbow turn time"
msgstr ""

#. 6.0->settings-schema.json->shadow-rainbow-turn-time->units
msgid "seconds"
msgstr ""

#. 6.0->settings-schema.json->shadow-rainbow-turn-time->tooltip
msgid ""
"How long the rainbow takes to go once around the window. 0 keeps it still."
msgstr ""

#. 6.0->settings-schema.json->shadow-color-all-windows->description
msgid "Colour every window's shadow"
msgstr ""

#. 6.0->settings-schema.json->shadow-color-all-windows->tooltip
msgid ""
"Off: only the focused window gets the coloured shadow, and unfocused windows "
"get a normal black one. On: every window gets it, and every rainbow turns, "
"which keeps the compositor busier."
msgstr ""
