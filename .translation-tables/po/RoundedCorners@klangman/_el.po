#. 6.0->settings-schema.json->border-theme-accent->description
msgid "Use the theme's accent colour"
msgstr ""

#. 6.0->settings-schema.json->border-theme-accent->options
msgid "Focused window"
msgstr ""

#. 6.0->settings-schema.json->border-theme-accent->options
msgid "All windows"
msgstr ""

#. 6.0->settings-schema.json->border-theme-accent->tooltip
msgid ""
"Draws the border in the accent colour of the current GTK theme (for example "
"the aqua of Mint-Y-Aqua) and follows it when the theme changes. Windows that "
"don't get the accent colour use the border colour below. If the theme "
"doesn't define an accent colour, the custom colours are used. Applications "
"in the Application border list keep their own colours."
msgstr ""

#. 6.0->settings-schema.json->border-accent-unfocused-opacity->description
msgid "Accent opacity for unfocused windows"
msgstr ""

#. 6.0->settings-schema.json->border-accent-unfocused-opacity->tooltip
msgid ""
"How opaque the accent coloured border is on every window except the one with "
"keyboard focus. The focused window's border is always drawn at the accent "
"colour's full opacity."
msgstr ""

