#. metadata.json->name
msgid "Desktop Cube Reloaded"
msgstr "Desktop Cube Reloaded"

#. metadata.json->description
msgid ""
"Rotate your workspaces as the faces of a 3D cube. A port of the GNOME "
"Desktop Cube extension by Simon Schneegans."
msgstr ""
"Gira tus espacios de trabajo como si fueran las caras de un cubo 3D. Una "
"adaptación de la extensión 'GNOME Desktop Cube' de Simon Schneegans."

