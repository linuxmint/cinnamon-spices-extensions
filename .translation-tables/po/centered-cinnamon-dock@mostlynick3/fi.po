#. 6.4/extension.js:68
msgid "Welcome to Centered Cinnamon Dock!"
msgstr "Tervetuloa Centered Cinnamon Dock!"

#. 6.4/extension.js:76
msgid "Which panel(s) would you like to turn into a dock?"
msgstr "Minkä paneelin haluat muuttaa kelluvaksi telakaksi?"

#. 6.4/extension.js:124
msgid "Right click any panel to change your mind or configure the docks later."
msgstr ""
"Paina mitä tahansa paneelia hiiren oikealla, jos haluat muuttaa valintaasi "
"tai määrittää ne myöhemmin."

