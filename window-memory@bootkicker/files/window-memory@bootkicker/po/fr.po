msgstr "Impossible de démarrer la sélection : %(reason)s"

msgid "Could not open Startup Applications: %(reason)s"
msgstr "Impossible d'ouvrir Applications au démarrage : %(reason)s"

msgid "Start at login"
msgstr "Lancer à l'ouverture de session"

msgid "Name"
msgstr "Nom"

