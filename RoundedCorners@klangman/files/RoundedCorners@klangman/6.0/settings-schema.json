{
    "layout": {
        "type": "layout",
        "pages": [
            "page-general",
            "page-borders",
            "page-shadow",
            "page-about"
        ],
        "page-general": {
            "type": "page",
            "title": "Corners",
            "sections": [
                "section-windows",
                "section-applications"
            ]
        },
        "page-borders": {
            "type": "page",
            "title": "Borders",
            "sections": [
                "section-border",
                "section-border-apps"
            ]
        },
        "page-shadow": {
            "type": "page",
            "title": "Shadows",
            "sections": [
                "section-shadow"
            ]
        },
        "page-about": {
            "type": "page",
            "title": "About",
            "sections": [
                "section-about"
            ]
        },
        "section-windows": {
            "type": "section",
            "title": "Windows",
            "keys": [
                "note-corners",
                "auto-include",
                "corner-radius",
                "corners-top",
                "corners-bottom",
                "disable-maximized"
            ]
        },
        "section-applications": {
            "type": "section",
            "title": "Applications",
            "keys": [
                "windows-inclusion-list",
                "windows-exclusion-list",
                "pick-application-window"
            ]
        },
        "section-border": {
            "type": "section",
            "title": "Window border",
            "keys": [
                "note-borders",
                "border-mode",
                "border-width",
                "border-contrast",
                "border-theme-accent",
                "border-accent-unfocused-opacity",
                "border-color",
                "border-color-unfocused"
            ]
        },
        "section-border-apps": {
            "type": "section",
            "title": "Application borders",
            "keys": [
                "border-app-list",
                "pick-border-window"
            ]
        },
        "section-shadow": {
            "type": "section",
            "title": "Window shadow",
            "keys": [
                "note-shadows",
                "shadow-enabled",
                "shadow-size",
                "shadow-offset",
                "shadow-opacity",
                "shadow-unfocused-opacity",
                "shadow-color-mode",
                "shadow-color",
                "shadow-color-2",
                "shadow-gradient-angle",
                "shadow-glow",
                "shadow-rainbow-turn-time",
                "shadow-color-all-windows"
            ]
        },
        "section-about": {
            "type": "section",
            "title": "About Rounded Corners",
            "keys": [
                "about-text"
            ]
        }
    },
    "note-corners": {
        "type": "custom",
        "file": "CustomWidgets.py",
        "widget": "Note",
        "description": "Most themes round the top corners of title bars, and this extension can’t undo that. A radius smaller than the theme’s will leave a gap between the border/shadow and the window corners. See the <a href=\"https://github.com/klangman/CinnamonRoundedCorners\">Rounded Corners website</a> for how to override the theme’s rounding."
    },
    "note-borders": {
        "type": "custom",
        "file": "CustomWidgets.py",
        "widget": "Note",
        "description": "Borders are only drawn on windows that have rounded corners (see the <b>Corners</b> tab). An application in the list below gets no border unless its windows are also rounded."
    },
    "note-shadows": {
        "type": "custom",
        "file": "CustomWidgets.py",
        "widget": "Note",
        "description": "This shadow is only drawn on windows that have rounded corners (see the <b>Corners</b> tab), replacing the desktop's own shadow for those windows. Other windows keep their normal shadow."
    },
    "auto-include": {
        "type": "switch",
        "description": "Round the corners of all windows by default",
        "default": false
    },
    "corner-radius": {
        "type": "spinbutton",
        "description": "Corner radius",
        "dependency": "auto-include",
        "default": 12,
        "min": 0,
        "max": 25,
        "step": 1,
        "units": "pixels",
        "tooltip": "The radius of the rounded corners applied to windows that are rounded by default (those not in the exclusion list)."
    },
    "corners-top": {
        "type": "switch",
        "description": "Round the top corners (recommended)",
        "dependency": "auto-include",
        "default": true,
        "tooltip": "If you disable top corner rounding but the theme does some rounding of it's own, the squared off top corner shadows will cause a ligher section to appear where the theme has rounded the corners. You may have better results if you enable top rounding to match the themes rounding radius."
    },
    "corners-bottom": {
        "type": "switch",
        "description": "Round the bottom corners",
        "dependency": "auto-include",
        "default": true
    },
    "disable-maximized": {
        "type": "switch",
        "description": "Don't round maximized windows",
        "default": true,
        "tooltip": "Removes the rounded corners, border and shadow while a window is maximized, and restores them when it is unmaximized. Fullscreen windows are never rounded."
    },
    "windows-inclusion-list": {
        "type": "list",
        "height": 200,
        "description": "Application window inclusion list",
        "dependency": "!auto-include",
        "columns": [
            {
                "id": "enabled",
                "title": "Enabled",
                "type": "boolean",
                "default": true
            },
            {
                "id": "application",
                "title": "Application",
                "type": "string",
                "default": ""
            },
            {
                "id": "corner_radius",
                "title": "Corner Radius",
                "type": "integer",
                "default": 12,
                "min": 0,
                "max": 25
            },
            {
                "id": "corner_top",
                "title": "Rounded Top",
                "type": "boolean",
                "default": true
            },
            {
                "id": "corner_bottom",
                "title": "Rounded Bottom",
                "type": "boolean",
                "default": false
            }
        ],
        "tooltip": "Defines a list of application windows where rounded corner effects will be applied and what effects to apply. The \"Application\" field can be a WM_CLASS or a desktop file name.",
        "default": []
    },
    "windows-exclusion-list": {
        "type": "list",
        "height": 200,
        "description": "Application window exclusion list",
        "dependency": "auto-include",
        "columns": [
            {
                "id": "enabled",
                "title": "Exclude",
                "type": "boolean",
                "default": true
            },
            {
                "id": "application",
                "title": "Application",
                "type": "string",
                "default": ""
            }
        ],
        "tooltip": "Defines a list of application windows where rounded corner effects will NOT be applied. The \"Application\" field can be a WM_CLASS or a desktop file name.",
        "default": []
    },
    "pick-application-window": {
        "type": "button",
        "description": "Pick a window to add…",
        "callback": "on_pick_application_window",
        "tooltip": "Click this, then click any window to add its application to the list above (the exclusion list when windows are rounded by default, otherwise the inclusion list). Press Esc or right-click to cancel."
    },
    "border-mode": {
        "type": "combobox",
        "description": "Border",
        "default": "match",
        "options": {
            "None": "none",
            "Match the window's own border": "match",
            "Automatic (contrast with the window edge)": "auto",
            "Custom": "custom-colors"
        },
        "tooltip": "Draws a thin border just inside the rounded edge of rounded windows. Match continues the window's own border colours around the rounded corners. Automatic darkens light edges and lightens dark ones. Custom draws the colours you choose, one for the focused window and one for unfocused windows."
    },
    "border-width": {
        "type": "spinbutton",
        "description": "Border width",
        "dependency": "border-mode!=none",
        "default": 1,
        "min": 1,
        "max": 4,
        "step": 1,
        "units": "pixels",
        "tooltip": "How many pixels in from the rounded edge the border reaches. With Match, nothing is drawn on the straight edges; this sets how many of the window's own edge pixel layers are carried around the rounded corners. Set it to the width of the theme's border lines (usually 1 or 2): any extra repeats the window's content colours from the edges into the corners."
    },
    "border-contrast": {
        "type": "spinbutton",
        "description": "Border contrast",
        "dependency": "border-mode=auto",
        "default": 20,
        "min": 0,
        "max": 100,
        "step": 5,
        "units": "%",
        "tooltip": "How far the border colour is moved from the window's edge colour towards black (on light edges) or white (on dark edges)."
    },
    "border-theme-accent": {
        "type": "combobox",
        "description": "Use the theme's accent colour",
        "dependency": "border-mode=custom-colors",
        "default": "none",
        "options": {
            "None": "none",
            "Focused window": "focused",
            "All windows": "all"
        },
        "tooltip": "Draws the border in the accent colour of the current GTK theme (for example the aqua of Mint-Y-Aqua) and follows it when the theme changes. Windows that don't get the accent colour use the border colour below. If the theme doesn't define an accent colour, the custom colours are used. Applications in the Application border list keep their own colours."
    },
    "border-accent-unfocused-opacity": {
        "type": "spinbutton",
        "description": "Accent opacity for unfocused windows",
        "dependency": "border-mode=custom-colors & border-theme-accent=all",
        "default": 40,
        "min": 0,
        "max": 100,
        "step": 5,
        "units": "%",
        "tooltip": "How opaque the accent coloured border is on every window except the one with keyboard focus. The focused window's border is always drawn at the accent colour's full opacity."
    },
    "border-color": {
        "type": "colorchooser",
        "description": "Border colour (focused window)",
        "dependency": "border-mode=custom-colors & border-theme-accent=none",
        "default": "rgba(0,0,0,0.3)"
    },
    "border-color-unfocused": {
        "type": "colorchooser",
        "description": "Border colour (unfocused windows)",
        "dependency": "border-mode=custom-colors & border-theme-accent!=all",
        "default": "rgba(0,0,0,0.15)"
    },
    "border-app-list": {
        "type": "list",
        "height": 250,
        "description": "Application border list",
        "columns": [
            {
                "id": "enabled",
                "title": "Enabled",
                "type": "boolean",
                "default": true
            },
            {
                "id": "application",
                "title": "Application",
                "type": "string",
                "default": ""
            },
            {
                "id": "mode",
                "title": "Border",
                "type": "string",
                "default": "custom-colors",
                "options": {
                    "None": "none",
                    "Match the window's own border": "match",
                    "Automatic (contrast with the window edge)": "auto",
                    "Custom": "custom-colors"
                }
            },
            {
                "id": "width",
                "title": "Width",
                "type": "integer",
                "default": 1,
                "min": 1,
                "max": 4
            },
            {
                "id": "contrast",
                "title": "Contrast %",
                "type": "integer",
                "default": 20,
                "min": 0,
                "max": 100
            },
            {
                "id": "color",
                "title": "Colour (focused)",
                "type": "string",
                "default": "rgba(0,0,0,0.3)",
                "color-chooser": "optional"
            },
            {
                "id": "color_unfocused",
                "title": "Colour (unfocused)",
                "type": "string",
                "default": "rgba(0,0,0,0.15)",
                "color-chooser": "optional"
            }
        ],
        "tooltip": "Gives particular applications their own border, overriding the settings above. The \"Application\" field can be a WM_CLASS or a desktop file name. Contrast is only used by Automatic, and the colours only by Custom. Click a colour in the list to change it. A colour set to Default uses the matching colour above.",
        "default": []
    },
    "pick-border-window": {
        "type": "button",
        "description": "Pick a window to add…",
        "callback": "on_pick_border_window",
        "tooltip": "Click this, then click any window to add its application to the application border list. Press Esc or right-click to cancel."
    },
    "shadow-enabled": {
        "type": "switch",
        "description": "Draw a shadow that follows the rounded corners",
        "default": true,
        "tooltip": "Muffin's own shadow is always turned off for rounded windows, because it doesn't follow the rounded corners. With this off, rounded windows have no shadow."
    },
    "shadow-size": {
        "type": "spinbutton",
        "description": "Shadow size",
        "dependency": "shadow-enabled",
        "default": 20,
        "min": 2,
        "max": 60,
        "step": 1,
        "units": "pixels"
    },
    "shadow-offset": {
        "type": "spinbutton",
        "description": "Shadow vertical offset",
        "dependency": "shadow-enabled",
        "default": 3,
        "min": 0,
        "max": 20,
        "step": 1,
        "units": "pixels",
        "tooltip": "Moves the shadow down, as if lit from above."
    },
    "shadow-opacity": {
        "type": "spinbutton",
        "description": "Shadow strength (focused window)",
        "dependency": "shadow-enabled",
        "default": 40,
        "min": 0,
        "max": 100,
        "step": 5,
        "units": "%"
    },
    "shadow-unfocused-opacity": {
        "type": "spinbutton",
        "description": "Shadow strength (unfocused windows)",
        "dependency": "shadow-enabled",
        "default": 25,
        "min": 0,
        "max": 100,
        "step": 5,
        "units": "%"
    },
    "shadow-color-mode": {
        "type": "combobox",
        "description": "Shadow colour",
        "dependency": "shadow-enabled",
        "default": "black",
        "options": {
            "Black": "black",
            "Single colour": "color",
            "Gradient": "gradient",
            "Rainbow": "rainbow"
        },
        "tooltip": "Black is a normal shadow. The other options colour it; with some glow and no vertical offset they look more like a coloured light around the window."
    },
    "shadow-color": {
        "type": "colorchooser",
        "description": "Colour (gradient start)",
        "dependency": "shadow-color-mode!=black",
        "default": "rgb(255,0,128)",
        "tooltip": "Used by Single colour, and as the gradient's start colour. Not used by Rainbow."
    },
    "shadow-color-2": {
        "type": "colorchooser",
        "description": "Gradient end colour",
        "dependency": "shadow-color-mode=gradient",
        "default": "rgb(0,160,255)"
    },
    "shadow-gradient-angle": {
        "type": "spinbutton",
        "description": "Gradient direction",
        "dependency": "shadow-color-mode=gradient",
        "default": 45,
        "min": 0,
        "max": 359,
        "step": 15,
        "units": "degrees",
        "tooltip": "0 runs from left to right, 90 from top to bottom."
    },
    "shadow-glow": {
        "type": "spinbutton",
        "description": "Glow",
        "dependency": "shadow-color-mode!=black",
        "default": 50,
        "min": 0,
        "max": 100,
        "step": 10,
        "units": "%",
        "tooltip": "How much the colour adds light to what's behind it instead of covering it. 0 looks like a coloured shadow, 100 like a neon glow."
    },
    "shadow-rainbow-turn-time": {
        "type": "spinbutton",
        "description": "Rainbow turn time",
        "dependency": "shadow-color-mode=rainbow",
        "default": 8,
        "min": 0,
        "max": 60,
        "step": 1,
        "units": "seconds",
        "tooltip": "How long the rainbow takes to go once around the window. 0 keeps it still."
    },
    "shadow-color-all-windows": {
        "type": "switch",
        "description": "Colour every window's shadow",
        "dependency": "shadow-color-mode!=black",
        "default": false,
        "tooltip": "Off: only the focused window gets the coloured shadow, and unfocused windows get a normal black one. On: every window gets it, and every rainbow turns, which keeps the compositor busier."
    },
    "about-text": {
        "type": "custom",
        "file": "CustomWidgets.py",
        "widget": "About",
        "description": "\n<b>Rounded Corners</b>\nVersion: ext-version\n\nDeveloped by: Kevin Langman\n<a href=\"https://github.com/klangman/CinnamonRoundedCorners\">Github</a> / <a href=\"https://github.com/klangman/CinnamonRoundedCorners/issues/new\">Report an issue</a>\n\nThe rounded corners effect is based on Blur-my-shell code by aunetx and contributors <a href=\"https://github.com/aunetx/blur-my-shell\">Github</a> / <a href=\"https://ko-fi.com/aunetx\">Ko-fi</a>",
        "icon": "/icon.png"
    },
    "ext-version": {
        "type": "generic",
        "default": ""
    },
    "new-install": {
        "type": "generic",
        "default": 1
    }
}
