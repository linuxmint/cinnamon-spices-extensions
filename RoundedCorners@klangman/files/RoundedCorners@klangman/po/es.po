msgstr "Cuando está desactivado, se utiliza el color predeterminado"

#. 6.0/CustomWidgets.py:193
msgid "Default"
msgstr "Predeterminado"

#. 6.0/CustomWidgets.py:229
msgid "Use Default"
msgstr "Usar la configuración predeterminada"

#. metadata.json->name
