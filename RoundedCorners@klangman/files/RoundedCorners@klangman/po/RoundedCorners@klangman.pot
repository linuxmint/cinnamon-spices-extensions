#. 6.0->settings-schema.json->windows-inclusion-list->tooltip
msgid ""
"Defines a list of application windows where rounded corner effects will be "
"applied and what effects to apply. The \"Application\" field can be a "
"WM_CLASS or a desktop file name."
msgstr ""

#. 6.0->settings-schema.json->windows-exclusion-list->description
msgid "Application window exclusion list"
msgstr ""

#. 6.0->settings-schema.json->windows-exclusion-list->columns->title
msgid "Exclude"
msgstr ""

#. 6.0->settings-schema.json->windows-exclusion-list->tooltip
msgid ""
"Defines a list of application windows where rounded corner effects will NOT "
"be applied. The \"Application\" field can be a WM_CLASS or a desktop file "
"name."
msgstr ""

#. 6.0->settings-schema.json->pick-application-window->description
#. 6.0->settings-schema.json->pick-border-window->description
msgid "Pick a window to add…"
msgstr ""

#. 6.0->settings-schema.json->pick-application-window->tooltip
msgid ""
"Click this, then click any window to add its application to the list above "
"(the exclusion list when windows are rounded by default, otherwise the "
"inclusion list). Press Esc or right-click to cancel."
msgstr ""

#. 6.0->settings-schema.json->border-mode->description
#. 6.0->settings-schema.json->border-app-list->columns->title
msgid "Border"
msgstr ""

#. 6.0->settings-schema.json->border-mode->options
msgid "None"
msgstr ""

#. 6.0->settings-schema.json->border-mode->options
msgid "Match the window's own border"
msgstr ""

#. 6.0->settings-schema.json->border-mode->options
msgid "Automatic (contrast with the window edge)"
msgstr ""

#. 6.0->settings-schema.json->border-mode->options
msgid "Custom"
msgstr ""

#. 6.0->settings-schema.json->border-mode->tooltip
msgid ""
"Draws a thin border just inside the rounded edge of rounded windows. Match "
"continues the window's own border colours around the rounded corners. "
"Automatic darkens light edges and lightens dark ones. Custom draws the "
"colours you choose, one for the focused window and one for other windows."
msgstr ""

#. 6.0->settings-schema.json->border-width->description
msgid "Border width"
msgstr ""

#. 6.0->settings-schema.json->border-width->tooltip
msgid ""
"How many pixels in from the rounded edge the border reaches. With Match, "
"nothing is drawn on the straight edges; this sets how many of the window's "
"own edge pixel layers are carried around the rounded corners. Set it to the "
"width of the theme's border lines (usually 1 or 2): any extra repeats the "
"window's content colours from the edges into the corners."
msgstr ""

#. 6.0->settings-schema.json->border-contrast->description
msgid "Border contrast"
msgstr ""

#. 6.0->settings-schema.json->border-contrast->units
#. 6.0->settings-schema.json->shadow-opacity->units
#. 6.0->settings-schema.json->shadow-unfocused-opacity->units
msgid "%"
msgstr ""

#. 6.0->settings-schema.json->border-contrast->tooltip
msgid ""
"How far the border colour is moved from the window's edge colour towards "
"black (on light edges) or white (on dark edges)."
msgstr ""

#. 6.0->settings-schema.json->border-color->description
msgid "Border colour (focused window)"
msgstr ""

#. 6.0->settings-schema.json->border-color-unfocused->description
msgid "Border colour (other windows)"
msgstr ""

#. 6.0->settings-schema.json->border-app-list->description
msgid "Application border list"
msgstr ""

#. 6.0->settings-schema.json->border-app-list->columns->title
msgid "Width"
msgstr ""

#. 6.0->settings-schema.json->border-app-list->columns->title
msgid "Contrast %"
msgstr ""

#. 6.0->settings-schema.json->border-app-list->columns->title
msgid "Colour (focused)"
msgstr ""

#. 6.0->settings-schema.json->border-app-list->columns->title
msgid "Colour (other)"
msgstr ""

#. 6.0->settings-schema.json->border-app-list->tooltip
msgid ""
"Gives particular applications their own border, overriding the settings "
"above. The \"Application\" field can be a WM_CLASS or a desktop file name. "
"Contrast is only used by Automatic, and the colours only by Custom. Click a "
"colour in the list to change it. A colour set to Default uses the matching "
"colour above."
msgstr ""

#. 6.0->settings-schema.json->pick-border-window->tooltip
msgid ""
"Click this, then click any window to add its application to the application "
"border list. Press Esc or right-click to cancel."
msgstr ""

#. 6.0->settings-schema.json->shadow-enabled->description
msgid "Draw a shadow that follows the rounded corners"
msgstr ""

#. 6.0->settings-schema.json->shadow-enabled->tooltip
msgid ""
"Muffin's own shadow is always turned off for rounded windows, because it "
"doesn't follow the rounded corners. With this off, rounded windows have no "
"shadow."
msgstr ""

