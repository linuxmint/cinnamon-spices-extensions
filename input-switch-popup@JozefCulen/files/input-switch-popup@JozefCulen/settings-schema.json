{
    "position-mode": {
        "type": "combobox",
        "default": "caret",
        "description": "Popup position",
        "options": {
            "Text caret (fallback to mouse pointer)": "caret",
            "Mouse pointer": "pointer"
        }
    },
    "show-all": {
        "type": "switch",
        "default": true,
        "description": "Show all layouts (highlight slides to the active one)"
    },
    "duration-ms": {
        "type": "spinbutton",
        "default": 800,
        "min": 200,
        "max": 5000,
        "step": 100,
        "units": "ms",
        "description": "How long the popup stays visible"
    },
    "font-size": {
        "type": "spinbutton",
        "default": 18,
        "min": 8,
        "max": 72,
        "step": 1,
        "units": "px",
        "description": "Font size"
    }
}
